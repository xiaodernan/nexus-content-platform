{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "description": "NEXUS — an AI-native creative operating system. Turn ideas into executable digital worlds.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "agents/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:harness": "node tools/harness/smoke.mjs",
    "verify:studio": "node tools/harness/studio-golden-path.mjs",
    "verify:scene": "node tools/harness/studio-scene3d.mjs",
    "verify:scene-surface": "node docs/evidence/studio/scene-surface-proof.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "verify:world": "node tools/harness/studio-world.mjs",
    "verify:world-surface": "node docs/evidence/studio/world-surface-proof.mjs",
    "verify:assets": "node tools/harness/studio-assets.mjs",
    "verify:assets-surface": "node docs/evidence/studio/asset-surface-proof.mjs",
    "verify:publish": "node docs/evidence/m7/publish-proof.mjs",
    "verify:api-tests": "mvn -B test -f services/nexus-api/pom.xml",
    "verify:publish-e2e": "node tools/harness/studio-publish.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@11.12.1"
}
