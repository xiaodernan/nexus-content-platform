{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "description": "NEXUS — an AI-native creative operating system. Turn ideas into executable digital worlds.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "agents/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:harness": "node tools/harness/smoke.mjs",
    "verify:studio": "node tools/harness/studio-golden-path.mjs",
    "verify:scene": "node tools/harness/studio-scene3d.mjs",
    "verify:scene-surface": "node docs/evidence/studio/scene-surface-proof.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "verify:world": "node tools/harness/studio-world.mjs",
    "verify:world-surface": "node docs/evidence/studio/world-surface-proof.mjs",
    "verify:assets": "node tools/harness/studio-assets.mjs",
    "verify:assets-surface": "node docs/evidence/studio/asset-surface-proof.mjs",
    "verify:publish": "node docs/evidence/m7/publish-proof.mjs",
    "verify:api-tests": "mvn -B test -f services/nexus-api/pom.xml",
    "verify:publish-e2e": "node tools/harness/studio-publish.mjs",
    "verify:account": "node tools/harness/studio-account.mjs",
    "verify:leak-sweep": "node docs/evidence/m7/leak-sweep-proof.mjs",
    "verify:remix": "node docs/evidence/m7/remix-proof.mjs",
    "verify:explore": "node docs/evidence/m7/explore-proof.mjs",
    "verify:trail-contract": "node docs/evidence/m9/trail-contract-proof.mjs",
    "verify:social-contract": "node docs/evidence/m9/social-contract-proof.mjs",
    "verify:validate": "node docs/evidence/design-model/validate-proof.mjs",
    "verify:png": "node docs/evidence/studio/png-baseline-proof.mjs",
    "verify:service": "node docs/evidence/m7/service-suite-proof.mjs",
    "verify:credits": "node docs/evidence/studio/credits-proof.mjs",
    "verify:mutation": "node docs/evidence/studio/mutation-probe.mjs",
    "verify:credits-surface": "node tools/harness/studio-credits.mjs",
    "verify:ci-wiring": "node docs/evidence/ci/ci-wiring-proof.mjs",
    "verify:evidence-census": "node docs/evidence/ci/evidence-census-proof.mjs",
    "verify:audit-contract": "node docs/evidence/m9/audit-contract-proof.mjs",
    "verify:record-encoding": "node docs/evidence/agents/record-encoding-proof.mjs",
    "verify:pipeline": "node docs/evidence/studio/pipeline-proof.mjs",
    "verify:table-recount": "node docs/evidence/agents/table-recount-proof.mjs",
    "verify:build-lane": "node docs/evidence/studio/build-lane-proof.mjs",
    "verify:container-lane": "node docs/evidence/studio/container-lane-proof.mjs",
    "verify:deploy-lane": "node docs/evidence/studio/deploy-lane-proof.mjs",
    "verify:agent": "node docs/evidence/agents/agent-proof.mjs",
    "verify:dom-ui": "node docs/evidence/agents/dom-ui-proof.mjs",
    "verify:execsuite": "node docs/evidence/agents/execsuite-proof.mjs",
    "verify:index-store": "node docs/evidence/agents/index-store-proof.mjs",
    "verify:index-vectors": "node docs/evidence/agents/index-vectors-proof.mjs",
    "verify:memory": "node docs/evidence/agents/memory-proof.mjs",
    "verify:memory-vectors": "node docs/evidence/agents/memory-vectors-proof.mjs",
    "verify:planner": "node docs/evidence/agents/planner-proof.mjs",
    "verify:provider": "node docs/evidence/agents/provider-proof.mjs",
    "verify:qa": "node docs/evidence/agents/qa-proof.mjs",
    "verify:recall": "node docs/evidence/agents/recall-proof.mjs",
    "verify:repair": "node docs/evidence/agents/repair-proof.mjs",
    "verify:rolechain": "node docs/evidence/agents/rolechain-proof.mjs",
    "verify:roles": "node docs/evidence/agents/roles-proof.mjs",
    "verify:testrunner": "node docs/evidence/agents/testrunner-proof.mjs",
    "verify:vector-store": "node docs/evidence/agents/vector-store-proof.mjs",
    "verify:proofs": "node tools/ci/proof-set.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@11.12.1"
}
