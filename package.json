{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nexus/web",
    "dev:ai": "bash infra/dev-ai.sh",
    "build": "npm run build -w @nexus/web",
    "start": "npm run start -w @nexus/web",
    "typecheck": "tsc -p packages/design-model/tsconfig.json --noEmit && tsc -p packages/world-model/tsconfig.json --noEmit && tsc -p packages/game-model/tsconfig.json --noEmit && tsc -p packages/video-model/tsconfig.json --noEmit && tsc -p packages/schemas/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/mcp-server/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "eslint": "eslint .",
    "lint": "npm run typecheck && npm run eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage:models": "vitest run --coverage packages/game-model --coverage.thresholds.branches=95 --coverage.thresholds.statements=99.5 --coverage.thresholds.functions=99 --coverage.thresholds.lines=99.5",
    "coverage:parity": "vitest run --coverage packages/game-model/test/sim-parity.test.ts packages/game-model/test/story-parity.test.ts",
    "coverage:arms": "tsx scripts/coverage-arms.mts",
    "perf:browser": "tsx scripts/perf-browser.mts",
    "parity:game-code": "tsx scripts/game-code-parity.mts",
    "test:ai-service": "apps\\ai-service\\.venv\\Scripts\\python.exe -m pytest apps/ai-service/tests -q",
    "contract:export": "tsx scripts/export-ai-contract.mts",
    "mcp:serve": "npm run start -w @nexus/mcp-server",
    "mcp:serve:http": "npm run start:http -w @nexus/mcp-server",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "e2e:admin-fixture": "tsx scripts/e2e-admin-fixture.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "two:instance": "tsx scripts/two-instance-roundtrip.mts",
    "realtime:two-process": "tsx scripts/realtime-two-process.mts",
    "probe:413": "tsx scripts/import-413-probe.mts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/db-seed.mts",
    "db:studio": "drizzle-kit studio",
    "infra:up": "docker compose -f infra/docker-compose.yml --profile core up -d",
    "infra:up:full": "docker compose -f infra/docker-compose.yml --profile full up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --profile core --profile full down",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,md}\" \"packages/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "axe-core": "^4.14.0",
    "eslint": "10.11.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.1",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
