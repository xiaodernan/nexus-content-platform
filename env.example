# Copy to .env — nothing here is required for the Studio slice (runs on DEMO MODE).
# Live AI provider keys enable the ModelRouter to prefer real providers over DEMO MODE.

# Provider keys (leave unset to stay in DEMO MODE — see ADR 0010)
# NEXUS_DEMO=1                       # explicit DEMO MODE toggle (default when no keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# STABILITY_API_KEY=                 # image
# RUNWAY_API_KEY=                    # video

# services/nexus-api (Spring Boot)
DATABASE_URL=jdbc:postgresql://localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# services/ai-svc (FastAPI) + storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexussecret

# apps/ai-service — LLM provider 前缀缓存（ADR 0123 / 0127）
# wkapi.pro / gpt-6-sol 实测：带稳定 prompt_cache_key 时连续轮次前缀命中从 1/8 -> 8/8。
# 不认识该字段的网关设 0 降级（出站报文 byte-level 还原）。
# NEXUS_LLM_STICKY_CACHE_KEY=1     # 默认 1；0 = 关闭粘性路由
# NEXUS_LLM_STREAM=1               # 默认 1（SSE + include_usage）；0 = 非流
# NEXUS_LLM_COMPLETION_CACHE_URL=  # 非空则启用跨实例 Redis completion 缓存
# NEXUS_LLM_COMPLETION_CACHE_TTL_S=3600
# NEXUS_LLM_SINGLE_FLIGHT=1        # 默认 1：同 key 并发 miss 只打 1 次真 LLM（ADR 0128）
#                                 # 仅当上面的 completion cache 启用时生效；0 = 并发各打各的
# NEXUS_LLM_SINGLE_FLIGHT_WAIT_S=30 # follower 有界等待上限；超时自己补打真调用，不伪造命中
# 跨进程 single-flight（ADR 0129）：多副本部署时把"两个实例同时 miss"合成一次真 LLM。
# 默认关闭（零回归）；=1 才抢 Redis SET NX EX 租约，需要 completion cache 已启用且 Redis 可达。
# NEXUS_LLM_DISTRIBUTED_SINGLE_FLIGHT=0
# NEXUS_LLM_DISTRIBUTED_FLIGHT_WAIT_S=180  # follower 轮询 done 标记的上限
# NEXUS_LLM_DISTRIBUTED_FLIGHT_POLL_S=0.25 # 轮询间隔（RTT 与延迟的取舍）
# NEXUS_LLM_DISTRIBUTED_FLIGHT_LEASE_S=240 # 锁租约；必须 >= WAIT_S 且 > AI_SERVICE_TIMEOUT_S
#                                         # （否则 leader 还在打模型锁就过期，follower 双花）
# AI_SERVICE_JOB_MAX_ATTEMPTS=1    # >1 开启有界重试 + 死信（ADR 0120）
