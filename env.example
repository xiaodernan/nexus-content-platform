# Copy to .env — nothing here is required for the Studio slice (runs on DEMO MODE).
# Live AI provider keys flip web's DEMO MODE -> LIVE PROVIDER (§160) via ai-service /healthz.

# ── AI provider（真实 key 只进 ai-service 进程，web 永不持有：docs/SECURITY.md）──
# 完整、权威的样例见 apps/ai-service/.env.example（NEXUS_OPENAI_* / NEXUS_MODEL_* /
# NEXUS_LLM_JSON_MODE / AI_SERVICE_*）。
# 注意：旧名 OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY 不会被 load_settings 读取，
# 照旧名配会 has_llm=false、静默停留在 DEMO MODE。请只按 apps/ai-service/.env.example 配。
# 不配置 → capability=unavailable，web 如实显示 DEMO MODE（§159，绝不假装可用）。
# 接入取证 + 三层可复检判据：docs/evidence/ai-provider-live/ · python scripts/probe-provider.py

# ── web → ai-service 的地址（另一个开关，配了 key 也别忘了它）──
# ai-service 那边 key 配好、/healthz 报 capability=real，web 若不知道地址，仍然一路走确定性 Mock：
# 现象只是首页显示"未配置 NEXUS_AI_SERVICE_URL"，很容易被读成"provider 没配"。
#   NEXUS_AI_SERVICE_URL=http://127.0.0.1:3200
# 开发模式（NODE_ENV=development）现在按约定端口自动补这个缺省，不配也连得上；
# 生产不补——没配就该如实报未配置，而不是去连一个必然连不上的 127.0.0.1。

# services/nexus-api (Spring Boot)
DATABASE_URL=jdbc:postgresql://localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# services/ai-svc (FastAPI) + storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexussecret
