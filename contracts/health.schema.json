{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "enum": [
        "real",
        "demo",
        "unavailable"
      ]
    },
    "providers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "llm",
              "image",
              "video",
              "embedding",
              "speech"
            ]
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "real",
              "demo",
              "unavailable"
            ]
          },
          "models": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "status",
          "models"
        ],
        "additionalProperties": false
      }
    },
    "queue": {
      "default": {
        "backend": "none",
        "pending": 0,
        "running": 0,
        "capacity": 0,
        "note": ""
      },
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "none",
            "memory",
            "redis"
          ]
        },
        "pending": {
          "default": 0,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "running": {
          "default": 0,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "capacity": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "note": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "pending",
        "running",
        "capacity",
        "note"
      ],
      "additionalProperties": false
    },
    "llmCache": {
      "default": null,
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "backend": { "type": "string", "enum": ["memory", "redis"] },
            "hits": { "type": "integer", "minimum": 0 },
            "misses": { "type": "integer", "minimum": 0 },
            "stores": { "type": "integer", "minimum": 0 },
            "stores_failed": { "type": "integer", "minimum": 0 },
            "evictions": { "type": "integer", "minimum": 0 },
            "hit_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "namespace": { "type": "string" },
            "degraded": { "type": "boolean" },
            "shared": { "type": "boolean" }
          },
          "required": [
            "enabled",
            "backend",
            "hits",
            "misses",
            "stores",
            "stores_failed",
            "evictions",
            "hit_rate",
            "namespace",
            "degraded"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "service",
    "version",
    "capability",
    "providers",
    "queue"
  ],
  "additionalProperties": false
}
