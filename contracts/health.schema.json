{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "enum": [
        "real",
        "demo",
        "unavailable"
      ]
    },
    "providers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "llm",
              "image",
              "video",
              "embedding",
              "speech"
            ]
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "real",
              "demo",
              "unavailable"
            ]
          },
          "models": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "status",
          "models"
        ],
        "additionalProperties": false
      }
    },
    "queue": {
      "default": {
        "backend": "none",
        "pending": 0,
        "running": 0,
        "capacity": 0,
        "note": ""
      },
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "none",
            "memory",
            "redis"
          ]
        },
        "pending": {
          "default": 0,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "running": {
          "default": 0,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "capacity": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "note": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "pending",
        "running",
        "capacity",
        "note"
      ],
      "additionalProperties": false
    },
    "llmCache": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "backend": {
                  "type": "string",
                  "enum": [
                    "memory",
                    "redis"
                  ]
                },
                "hits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "misses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "stores": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "stores_failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "evictions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "hit_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "namespace": {
                  "type": "string"
                },
                "degraded": {
                  "type": "boolean"
                },
                "shared": {
                  "type": "boolean"
                }
              },
              "required": [
                "enabled",
                "backend",
                "hits",
                "misses",
                "stores",
                "stores_failed",
                "evictions",
                "hit_rate",
                "namespace",
                "degraded"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "llmLatency": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "calls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "errors": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "window": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "avg_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "p50_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "p95_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "max_ms": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "calls",
                "errors",
                "window",
                "avg_ms",
                "p50_ms",
                "p95_ms",
                "max_ms"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "llmFlight": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "local",
                    "local+redis"
                  ]
                },
                "local": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "leaders": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "joined": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "coalesced": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "failures": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "timeouts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "real_calls": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "degraded": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "leaders",
                        "joined",
                        "coalesced",
                        "failures",
                        "timeouts",
                        "real_calls"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "distributed": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "leaders": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "joined": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "coalesced": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "timeouts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "self_served": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "lock_failures": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "marker_failures": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "peek_misses": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "real_calls": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "degraded": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "leaders",
                        "joined",
                        "coalesced",
                        "timeouts",
                        "self_served",
                        "lock_failures",
                        "marker_failures",
                        "peek_misses",
                        "real_calls"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "provider_calls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "enabled",
                "mode",
                "local",
                "distributed",
                "provider_calls",
                "note"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "service",
    "version",
    "capability",
    "providers",
    "queue",
    "llmCache",
    "llmLatency",
    "llmFlight"
  ],
  "additionalProperties": false
}
