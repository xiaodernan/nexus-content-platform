{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "provider-unavailable",
        "provider-failed",
        "invalid-context",
        "permission-denied",
        "approval-required",
        "budget-exceeded",
        "validation-failed",
        "internal"
      ]
    },
    "message": {
      "type": "string"
    },
    "hint": {
      "type": "string"
    },
    "retryable": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "additionalProperties": false
}
