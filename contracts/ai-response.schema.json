{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "enum": [
        "real",
        "demo",
        "unavailable"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "plans": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "constraints": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tasks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "agent": {
                  "type": "string"
                },
                "status": {
                  "default": "pending",
                  "type": "string",
                  "enum": [
                    "pending",
                    "running",
                    "done",
                    "failed",
                    "skipped"
                  ]
                },
                "dependsOn": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "artifact": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "agent",
                "status",
                "dependsOn"
              ],
              "additionalProperties": false
            }
          },
          "dependencies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "risks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "goal",
          "constraints",
          "tasks",
          "dependencies",
          "risks",
          "validation"
        ],
        "additionalProperties": false
      }
    },
    "patches": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          },
          "pageId": {
            "type": "string"
          },
          "ops": {
            "maxItems": 4000,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "set"
                    },
                    "nodeId": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "op",
                    "nodeId",
                    "path",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "merge"
                    },
                    "nodeId": {
                      "type": "string"
                    },
                    "path": {
                      "default": "",
                      "type": "string"
                    },
                    "value": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "op",
                    "nodeId",
                    "path",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "insert"
                    },
                    "node": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "parentId": {
                      "type": "string"
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "op",
                    "node",
                    "parentId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "remove"
                    },
                    "nodeId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "nodeId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "reparent"
                    },
                    "nodeId": {
                      "type": "string"
                    },
                    "parentId": {
                      "type": "string"
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "op",
                    "nodeId",
                    "parentId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "reorder"
                    },
                    "parentId": {
                      "type": "string"
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "op",
                    "parentId",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "setToken"
                    },
                    "key": {
                      "type": "string"
                    },
                    "value": {},
                    "mode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "key",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "addToken"
                    },
                    "token": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "op",
                    "token"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "removeToken"
                    },
                    "key": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "key"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "addComponent"
                    },
                    "component": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "op",
                    "component"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "addAsset"
                    },
                    "asset": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "op",
                    "asset"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "removeAsset"
                    },
                    "assetId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "assetId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "restoreAsset"
                    },
                    "asset": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "paints": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "nodes": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "op",
                    "asset",
                    "paints",
                    "nodes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "setVisualDna"
                    },
                    "dna": {
                      "anyOf": [
                        {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "op",
                    "dna"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "addPage"
                    },
                    "page": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "setActive": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "op",
                    "page"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "removePage"
                    },
                    "pageId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "op",
                    "pageId"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "ops"
        ],
        "additionalProperties": false
      }
    },
    "labels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "running",
              "completed",
              "failed",
              "info"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 400
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "artifactRef": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "stage",
          "status",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "usage": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "modelClass": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "reasoning",
            "vision",
            "image",
            "video",
            "embedding",
            "reranker"
          ]
        },
        "tokensIn": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokensOut": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "costUsd": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "toolCalls": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "demoMode": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "modelClass",
        "tokensIn",
        "tokensOut",
        "latencyMs",
        "costUsd",
        "toolCalls",
        "demoMode"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "provider-unavailable",
            "provider-failed",
            "invalid-context",
            "permission-denied",
            "approval-required",
            "budget-exceeded",
            "validation-failed",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requestId",
    "capability",
    "provider",
    "model",
    "plans",
    "patches",
    "labels",
    "activities",
    "explanation",
    "usage",
    "approvals"
  ],
  "additionalProperties": false
}
