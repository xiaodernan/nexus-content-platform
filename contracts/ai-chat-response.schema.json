{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "enum": [
        "real",
        "demo",
        "unavailable"
      ]
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "maxLength": 4000
    },
    "usage": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "modelClass": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "reasoning",
            "vision",
            "image",
            "video",
            "embedding",
            "reranker"
          ]
        },
        "tokensIn": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokensOut": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "costUsd": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "toolCalls": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "demoMode": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "modelClass",
        "tokensIn",
        "tokensOut",
        "latencyMs",
        "costUsd",
        "toolCalls",
        "demoMode"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "provider-unavailable",
            "provider-failed",
            "invalid-context",
            "permission-denied",
            "approval-required",
            "budget-exceeded",
            "validation-failed",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "capability",
    "provider",
    "model",
    "text",
    "usage"
  ],
  "additionalProperties": false
}
