{
  "name": "@nexus/three-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS M5 Three.js runtime: scene graph, a renderer/frame-scheduler seam, record types with their audits, and save files (ADR 0016 amendments 108-138).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
