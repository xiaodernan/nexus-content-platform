{
  "name": "@nexus/world-engine",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS M4 world engine: world/lore/character/location/faction types, WorldRAG retrieval, CharacterAgent, and the WorldEngine that orchestrates them (ADR 0016 amendments 144-146).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@nexus/agent-runtime": "*",
    "@nexus/ai-providers": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
