{
  "name": "@nexus/design-model",
  "version": "0.1.0",
  "private": true,
  "description": "The Nexus Design Model: canonical, immutable design representation + reversible operations (ADR 0004/0006).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
