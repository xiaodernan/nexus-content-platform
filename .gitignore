# dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# builds
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/

# local runtime
.env
.env.local
.env.*.local
*.pid
.DS_Store

# nexus local data
.nexus-store/
# 必须锚定到仓库根：不写前导 `/` 的 `storage/` 会把
# apps/web/src/server/storage/（存储驱动源码）也一起忽略掉，代码就悄悄丢了
/storage/
# 未配置 NEXUS_S3_* 时本地存储驱动的兜底目录（§101），以及各测试独占的临时目录
.nexus-storage*
screenshots/
.playwright-profile/
coverage/
test-results/
playwright-report/

# editors
.idea/
.vscode/
*.swp

# logs
logs/
*.log

# Agent 的临时实验区（变异探针、跑批脚本、原始日志）。不是项目内容，不进仓库；
# 但 eslint 会扫到它，所以忽略规则要同时写在 .gitignore 与 eslint.config.mjs 两处
.scratch/
