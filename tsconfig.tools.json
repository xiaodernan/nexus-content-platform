{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "scripts/**/*.mts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs",
    "apps/web/postcss.config.mjs",
  ]
}
