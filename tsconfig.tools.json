{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    // tsx 项目按完整文件名 import 同级 .mts（Node ESM 要扩展名、tsx 也这么认）；
    // 没有这条，`import './lib/x.mts'` 会被 tsc 以 TS5097 拒掉——类型检查是 noEmit，符合这个开关的前提。
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@nexus/creative-model": ["./packages/creative-model/src/index.ts"],
      "@nexus/schemas": ["./packages/schemas/src/index.ts"],
      "@nexus/world-model": ["./packages/world-model/src/index.ts"],
      "@nexus/game-model": ["./packages/game-model/src/index.ts"],
      "@nexus/video-model": ["./packages/video-model/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.mts",
    "scripts/**/*.ts",
    "evals/**/*.mts",
    "evals/**/*.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs",
    "apps/web/postcss.config.mjs",
    // 证据脚本与 tools/ 下的跑批脚本：它们不在任何 package tsconfig 里，allowJs 让它们进这个项目
    // （allowJs 已开、checkJs 关，所以 .mjs 不产生类型错误，只是给类型感知规则一份类型信息）。
    "docs/evidence/**/*.mjs",
    "tools/**/*.mjs",
    "tools/**/*.ts",
    // studio 的两个配置：apps/studio/tsconfig.json 只 include src/**，这两个在包根上。
    "apps/studio/next.config.ts",
    "apps/studio/vitest.config.ts",
  ]
}
