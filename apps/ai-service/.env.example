# ai-service 本地开发配置示例——填入真实值后改名保存为 `apps/ai-service/.env`
# （.env 已在 .gitignore 中，绝不提交 key、绝不打印、绝不进文档）。
# AI Service 只读进程 env（load_dotenv 指向本文件）；不需要人工 export。

# ── 可选：Redis 队列（有职责时强烈建议，跨重启不丢作业）──
NEXUS_REDIS_URL=redis://127.0.0.1:56379

# ── LLM Providers（OpenAI 兼容，含 wkapi.pro/Azure/Ollama 等）──
# 不配置任一行 → capability="mock"，capability 如实报 unavailable/mock，绝不假绿灯。
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
# 每档 model 各自可配；缺一档 → 该档 unavailable 如实报，不假装能跑。
NEXUS_MODEL_FAST=gpt-4o-mini
NEXUS_MODEL_BALANCED=gpt-4o
NEXUS_MODEL_REASONING=gpt-4o
NEXUS_MODEL_VISION=gpt-4o
NEXUS_MODEL_EMBEDDING=text-embedding-3-small
# JSON mode（对齐 §162 response_format: json_object 请求）。只在 provider 真的支持时=1。
NEXUS_LLM_JSON_MODE=1
# OpenAI 兼容网关的自动提示缓存路由键：同一 workload 的请求钉在同一分片，
# 命中 prompt caching（缓存 token 按网关折扣计费）。unset → 默认 nexus-studio；
# 显式置空串 → 不带该字段关闭。
# NEXUS_OPENAI_PROMPT_CACHE_KEY=nexus-studio

# ── 可选：GPU 图像/视频/语音切片（今天不实现，卡住不用装）──
# NEXUS_ANTHROPIC_API_KEY=
# NEXUS_GOOGLE_GEMINI_API_KEY=

# ── 队列并发（default 1）──
# AI_SERVICE_JOB_CONCURRENCY=1
# AI_SERVICE_PORT=3200
