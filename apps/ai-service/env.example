# 复制为 apps/ai-service/.env（该文件不入库），或放进 apps/web/.env.local 由 infra/dev-ai.sh 一并读取。
# 只填真实 provider 凭据；缺失时 ai-service 如实报告 unavailable，web 侧回落到标注过的 DEMO Mock（§159-160）。

AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=3200
AI_SERVICE_TIMEOUT_S=60

# OpenAI 兼容 chat/completions 端点（当前唯一实现的文本适配器）
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
NEXUS_LLM_JSON_MODE=1

# Model Router：意图档位 → 模型名（不填用内置默认）
NEXUS_MODEL_FAST=gpt-4o-mini
NEXUS_MODEL_BALANCED=gpt-4o
NEXUS_MODEL_REASONING=gpt-4o
NEXUS_MODEL_VISION=gpt-4o

# 检测到但尚未实现适配器的 key（服务会在 /healthz 里如实标为 unavailable）
# NEXUS_ANTHROPIC_API_KEY=
# NEXUS_GOOGLE_GEMINI_API_KEY=

# §162 作业队列。不设 URL = 内存后端（只此进程可见、重启即失，响应里的 note 会这么写）。
# 设了但连不上：服务启动直接失败，不会悄悄退回内存后端骗人。
# 本机 redis 容器按 docs/ENVIRONMENT.md 在 56379；实际在跑的 nexus-redis 目前映射到 6380，
# 两者不一致时以 `docker port nexus-redis` 为准（这个差异 2026-09-24 实测记录）。
# NEXUS_REDIS_URL=redis://127.0.0.1:56379/0
# 同时在跑几件活（16GB 内存、空闲约 2.5GB，默认 1）
AI_SERVICE_JOB_CONCURRENCY=1
# Redis 后端下作业结果的保留秒数（默认 3600）
AI_SERVICE_JOB_TTL_S=3600

# web 侧指向本服务
# NEXUS_AI_SERVICE_URL=http://127.0.0.1:3200
