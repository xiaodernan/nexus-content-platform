# 复制为 apps/ai-service/.env（该文件不入库），或放进 apps/web/.env.local 由 infra/dev-ai.sh 一并读取。
# 只填真实 provider 凭据；缺失时 ai-service 如实报告 unavailable，web 侧回落到标注过的 DEMO Mock（§159-160）。

AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=3200
# gpt-6-sol 推理调用可超 60s；默认 180 秒（可覆盖为 60/120/240）
AI_SERVICE_TIMEOUT_S=180

# OpenAI 兼容 chat/completions 端点（当前唯一实现的文本适配器）
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
NEXUS_LLM_JSON_MODE=1

# Model Router：意图档位 → 模型名（不填用内置默认）
NEXUS_MODEL_FAST=gpt-6-sol
NEXUS_MODEL_BALANCED=gpt-6-sol
NEXUS_MODEL_REASONING=gpt-6-sol
NEXUS_MODEL_VISION=gpt-6-sol
NEXUS_MODEL_EMBEDDING=none

# 流式响应（v690，ADR 0123）：默认 1（SSE）。真机实测（§CACHE-2）流式**有** usage
# （prompt_tokens / completion_tokens 都到）。`prompt_tokens_details.cached_tokens` 的缺席
# 规律是**冷前缀不报、暖前缀照报**：同一段前缀连发两轮流式，第一轮无该字段，
# 第二轮报 cached_tokens=7168（96.7%）。所以"没报"≠"报了 0"，账本用
# Completion.cache_reported 分这两件事，不许把"没报"写成"命中 0"。
# NEXUS_LLM_STREAM=0 恢复字节级非流行为。
NEXUS_LLM_STREAM=1

# LLM completion 缓存（v690，ADR 0123 / v686 RedisLlmCompletionCache）。默认关闭（零回归）。
# 指向 Redis 后全集群共享 "(model, system, user) → Completion" 缓存；全集群只需填一次真地址：
#   NEXUS_LLM_COMPLETION_CACHE_URL=redis://127.0.0.1:56379/8
# §CACHE-2 真机读数：同一条 AiRequest 连发两次，wall 8689ms → 71.4ms（122×），
# 第二次 usage.cachedTokens = tokensIn（整段输入复用，没有第二次 provider 调用）。
# 连接失败 fail-open（缓存故障不打挂 provider），healthz.llmCache 照实报 enabled/degraded。
# 命名空间（多环境隔离）：
# NEXUS_LLM_COMPLETION_CACHE_NAMESPACE=nexus:llmc
# 条目保留秒数（默认 3600）：
# NEXUS_LLM_COMPLETION_CACHE_TTL_S=3600

# 检测到但尚未实现适配器的 key（服务会在 /healthz 里如实标为 unavailable）
# NEXUS_ANTHROPIC_API_KEY=
# NEXUS_GOOGLE_GEMINI_API_KEY=

# §162 作业队列。不设 URL = 内存后端（只此进程可见、重启即失，响应里的 note 会这么写）。
# 设了但连不上：服务启动直接失败，不会悄悄退回内存后端骗人。
# 本机 redis 容器按 docs/ENVIRONMENT.md 在 56379；实际在跑的 nexus-redis 目前映射到 6380，
# 两者不一致时以 `docker port nexus-redis` 为准（这个差异 2026-09-24 实测记录）。
# NEXUS_REDIS_URL=redis://127.0.0.1:56379/0
# 同时在跑几件活（16GB 内存、空闲约 2.5GB，默认 1）
AI_SERVICE_JOB_CONCURRENCY=1
# Redis 后端下作业结果的保留秒数（默认 3600）
AI_SERVICE_JOB_TTL_S=3600

# web 侧指向本服务
# NEXUS_AI_SERVICE_URL=http://127.0.0.1:3200
