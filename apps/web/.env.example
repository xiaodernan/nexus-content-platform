# NEXUS web · 环境变量样板（复制为 .env.local 后填真实值）
# 纪律：这个文件只描述变量，绝不填秘密；秘密进 .env.local（被 .gitignore 屏蔽）。

# ── 数据库 ─────────────────────────────────────────
# Postgres（apps/web 迁移自己的 schema，ai-service 共用同一套 schema）。
NEXUS_DATABASE_URL=postgres://nexus:CHANGE_ME@127.0.0.1:5443/nexus
# 连接池大小（默认 10；压测时酌情调大）。
# NEXUS_DB_POOL=10

# ── 真 LLM / AI 服务 ───────────────────────────────
# web → ai-service 的内部地址（dev 默认 http://127.0.0.1:3200）。
NEXUS_AI_SERVICE_URL=http://127.0.0.1:3200
# 超时（毫秒）。
# NEXUS_AI_SERVICE_TIMEOUT_MS=180000

# ── 可选 Java/Spring 平面（actuator，公开只含计数） ─
# NEXUS_JAVA_HEALTH_URL=http://127.0.0.1:8082/actuator/health
# NEXUS_JAVA_BREAKERS_URL=http://127.0.0.1:8082/actuator/circuitbreakers
# NEXUS_JAVA_WIRE_STATS_URL=http://127.0.0.1:8082/actuator/wire/stats
# NEXUS_JAVA_ACTUATOR_INFO_URL=http://127.0.0.1:8082/actuator/info
# NEXUS_GATEWAY_HEALTH_URL=http://127.0.0.1:8081/healthz

# ── 缓存/限流（多实例生产必填，进程内桶只在 dev 用） ─
# NEXUS_REDIS_URL=redis://127.0.0.1:56379/0

# ── 会话/观测口令 ──────────────────────────────────
# 观察哨（/insight）进门口令。公网部署时务必设置成非 123 的强口令；不设置时 fallback 到 123。
# NEXUS_INSIGHT_PASSWORD=123

# ── 媒体存储（默认本地，可切到 S3 兼容） ──────────
# NEXUS_STORAGE_LOCAL_DIR=.nexus-storage
# NEXUS_S3_ENDPOINT=http://127.0.0.1:59000
# NEXUS_S3_REGION=us-east-1
# NEXUS_S3_BUCKET=nexus-assets
# NEXUS_S3_FORCE_PATH_STYLE=true

# ── 可选编排通道 ──────────────────────────────────
# 走 orchestration 路径时启用（默认 'stategraph'）。
# NEXUS_AI_CHAT_ORCHESTRATION=stategraph
# NEXUS_AI_ORCHESTRATION=stategraph

# ── 本地开发端口 ──────────────────────────────────
# AI_SERVICE_PORT=3200   # dev 用，prod 不设

# ── 杂项 ─────────────────────────────────────────
# NEXUS_PUBLIC_ORIGIN=https://nexus.example.com
# NEXUS_TRUSTED_PROXY_COUNT=1
