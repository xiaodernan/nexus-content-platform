<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEXUS — services/java-domain-service (the AUTHORITATIVE WRITE PATH for the domain tables).

  This service owns the writes for the rows the web layer only reads: `projects` and `users` are
  declared in `apps/web/src/server/db/schema.ts` (drizzle) and are the SAME tables this service's
  JPA entities map onto. Two writers on one table is a deliberate boundary, not an accident: the
  web layer's writes go through its own validated paths, and the DOMAIN writes go through here.

  Version alignment (measured 2026-11-09): this pom used to pin Spring Boot **3.2.0** (Jan 2024)
  and Java **21**, while every other Java service in this repository runs Spring Boot **3.5.16** on
  Java **25**. The consequence was that the service had NEVER BEEN COMPILED: `mvn -o test` failed
  with "Cannot access central in offline mode" for eleven artifacts, because Boot 3.2.0's
  dependency versions are not in this machine's local Maven repository — the repository holds
  Boot 3.5.16's. A service nobody has built is a service nobody can claim works.

  So the versions are now the repository's versions, and the compiler settings are copied from
  `services/nexus-api` — including the explicit UTF-8 encoding, which this repository has needed
  more than once (see the GBK records repair, ADR 0016 amendment 570).

  Dependencies this service declares:
  - eureka-client + config (SC-6/SC-11, registration OFF by default, `optional:` import) — see
    application.yml.
  - resilience4j since SC-60: the Feign client (AiServiceClient) reads it — the breaker exists and
    has a real caller.
  - spring-boot-starter-security: `SecurityConfig` defines the only filter chain this service has.
  - spring-boot-starter-validation + spring-boot-starter-cache: declared by this line's writes; a
    second schema/DDL writer (flyway) is deliberately absent — the domain tables are owned by the
    web layer's drizzle migrations, and a service whose schema is not its own must not carry a
    second migration tool pointing at it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.nexus</groupId>
    <artifactId>domain-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>NEXUS Domain Service</name>
    <description>NEXUS authoritative write path for project/user/community/permission/billing (Java Spring Boot).</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Cloud 2025.0.3 is the release train that matches Spring Boot 3.5.x (this service's
             parent) — the same train `services/nexus-api` and `services/java-gateway` ride. The BOM is
             imported rather than the versions being spelled out one by one, so the whole train moves as a
             unit. -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Security: SecurityConfig defines the only filter chain this service has -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (SC-8: health only).
             The operator's door. MEASURED 2026-11-11: this module exposed
             `health,info,metrics,prometheus` in its application.yml and carried the Prometheus
             registry, but had NO actuator on the classpath at all — so `/actuator/prometheus`
             answered 404 and the whole management block was decoration. A configuration that names
             endpoints nothing can serve is the same class of lie as an answer that names a failure
             it did not have; the topology proof's §10b found it by asking the door. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          §SC-78: spring-cloud-starter-loadbalancer 的实例列表供应器在首次构建时用默认缓存
          并在每个启动打印 WARN（L55 domain-service.log, verify:topology 实见）。加
          Caffeine 让 LB 走真正的本地缓存（org.springframework.cache.caffeine.CaffeineCacheManager
          由随附的 spring-context-support 提供）——这不是哄 WARN 的装饰：缓存会让 LB 在实例 up/down
          期间不再针对每条请求重新走 eureka-client 的实例目录解析。
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- §SC-77 / v656: Prometheus scrape endpoint on the operator door — the door answers with the
             metrics the same services already produce, in the standard format nothing invents. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Redis. The merged tree publishes the cross-process realtime wire through
             `WirePublisher` (StringRedisTemplate) and its tests (WirePublisherFrameShapeTest /
             WirePublisherRoundTripTest / WireCommunityEventListenerTest) use a real
             LettuceConnectionFactory — so the starter is NOT optional here, even though one of the
             merged lines had no RedisTemplate and removed it. `none` of that code is decorative:
             pub/sub is the wire; a frame nobody receives is simply dropped, never an error. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          No migration tool: this service maps onto a schema the WEB layer owns (apps/web/src/server/db/schema.ts
          and its Drizzle migrations). A second writer of DDL is how two systems disagree about the same table.
        -->

        <!--
          Service discovery (SC-6): registers as `nexus-domain-service` so the gateway can route to it by ID.
          Registration is OFF by default (`NEXUS_DOMAIN_REGISTER=false`): a standalone run must not depend on
          a registry answering on the dedicated port 8771.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!--
          SC-11: the client half of the config center (SC-9). The import is `optional:` and the client is OFF
          by default (see application.yml), so a standalone run never waits on 8888.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!--
          SC-18: OpenFeign — the declarative client for service-to-service calls (AiServiceClient).
          The client resolves ai-service by explicit URL (NEXUS_AI_SERVICE_URL, default the documented
          ai port 8000), so like everything above it is inert until a caller injects it.
          SC-60: the breaker has real pressure — repeated probes against a dead Python stop being free
          connection-refused episodes and become "stop trying for 10s"; the endpoint does not pretend.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    <!-- v656 — the bridge (only the bridge): this deployable RECEIVES the trace from the hop before it
         and continues it; it starts no outbound typed call of its own, so the Feign capability would be a
         dependency with nothing to attach to. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-brave</artifactId>
    </dependency>
  </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              SC-17: the community policy values document is exported by `npm run contract:export` into the
              repo-root contracts/ and copied into the jar here — CommunityPolicy reads it from the classpath
              and stops the context on any missing or malformed key. One file, one writer (the export), two
              readers (TS web domain, JVM policy loader).
            -->
            <resource>
                <directory>${project.basedir}/../../contracts</directory>
                <targetPath>contracts</targetPath>
                <includes>
                    <include>community-policy.json</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../contracts</directory>
                <targetPath>contracts</targetPath>
                <includes>
                    <include>community-policy.json</include>
                    <include>community-like-state.schema.json</include>
                    <include>community-follow-state.schema.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                    <source>25</source>
                    <target>25</target>
                    <compilerArgs>
                        <arg>-J-Dfile.encoding=UTF-8</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx512m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- SC-66: drop a META-INF/build-info.properties into the jar so /actuator/info
                         renders the artifact's real coordinates; Spring Boot auto-register the
                         BuildInfoContributor at startup when build.properties is visible on the classpath. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                    <!-- pinned at packaging time; nothing dynamic or secret. -->
                                    <component>nexus-domain-service</component>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
