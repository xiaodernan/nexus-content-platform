<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEXUS java-domain-service — the JVM write-path service (SC-6).

  Dependencies are the same set the standalone tests grade, plus the two Spring Cloud halves this
  service actually declares: eureka-client (SC-6, registration OFF by default) and config (SC-11,
  `optional:` import, OFF by default) — see application.yml. resilience4j is here since SC-60:
  the Feign client (AiServiceClient) reads it — the breaker exists and has a real caller.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.nexus</groupId>
    <artifactId>domain-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>NEXUS Domain Service</name>
    <description>Java Spring Boot domain services for NEXUS platform (user/project/community/permission/billing)</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Security: SecurityConfig defines the only filter chain this service has -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (SC-8: health only) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          No migration tool: this service maps onto a schema the WEB layer owns (apps/web/src/server/db/schema.ts
          and its Drizzle migrations). A second writer of DDL is how two systems disagree about the same table.
        -->

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          Service discovery (SC-6): registers as `nexus-domain-service` so the gateway can route to it by ID.
          Registration is OFF by default (`NEXUS_DOMAIN_REGISTER=false`): a standalone run must not depend on
          a registry answering on the dedicated port 8771.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!--
          SC-11: the client half of the config center (SC-9). The import is `optional:` and the client is OFF
          by default (see application.yml), so a standalone run never waits on 8888.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!--
          SC-18: OpenFeign — the declarative client for service-to-service calls (AiServiceClient).
          The client resolves ai-service by explicit URL (NEXUS_AI_SERVICE_URL, default the documented
          ai port 8000), so like everything above it is inert until a caller injects it.
          SC-60: the breaker has real pressure — repeated probes against a dead Python stop being free
          connection-refused episodes and become "stop trying for 10s"; the endpoint does not pretend.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              SC-17: the community policy values document is exported by `npm run contract:export` into the
              repo-root contracts/ and copied into the jar here — CommunityPolicy reads it from the classpath
              and stops the context on any missing or malformed key. One file, one writer (the export), two
              readers (TS web domain, JVM policy loader).
            -->
            <resource>
                <directory>${project.basedir}/../../contracts</directory>
                <targetPath>contracts</targetPath>
                <includes>
                    <include>community-policy.json</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../contracts</directory>
                <targetPath>contracts</targetPath>
                <includes>
                    <include>community-policy.json</include>
                    <include>community-like-state.schema.json</include>
                    <include>community-follow-state.schema.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                    <source>25</source>
                    <target>25</target>
                    <compilerArgs>
                        <arg>-J-Dfile.encoding=UTF-8</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx512m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
