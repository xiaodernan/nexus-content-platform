<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEXUS — services/java-domain-service (the AUTHORITATIVE WRITE PATH for the domain tables).

  This service owns the writes for the rows the web layer only reads: `projects` and `users` are
  declared in `apps/web/src/server/db/schema.ts` (drizzle) and are the SAME tables this service's
  JPA entities map onto. Two writers on one table is a deliberate boundary, not an accident: the
  web layer's writes go through its own validated paths, and the DOMAIN writes go through here.

  Version alignment (measured 2026-11-09): this pom used to pin Spring Boot **3.2.0** (Jan 2024)
  and Java **21**, while every other Java service in this repository runs Spring Boot **3.5.16** on
  Java **25**. The consequence was that the service had NEVER BEEN COMPILED: `mvn -o test` failed
  with "Cannot access central in offline mode" for eleven artifacts, because Boot 3.2.0's
  dependency versions are not in this machine's local Maven repository — the repository holds
  Boot 3.5.16's. A service nobody has built is a service nobody can claim works.

  So the versions are now the repository's versions, and the compiler settings are copied from
  `services/nexus-api` — including the explicit UTF-8 encoding, which this repository has needed
  more than once (see the GBK records repair, ADR 0016 amendment 570).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.nexus</groupId>
    <artifactId>domain-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>NEXUS Domain Service</name>
    <description>NEXUS authoritative write path for project/user/community/permission/billing (Java Spring Boot).</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Cloud 2025.0.3 is the release train that matches Spring Boot 3.5.x (this service's
             parent) — the same train `services/nexus-api` and `services/java-gateway` ride. The BOM is
             imported rather than the versions being spelled out one by one, so the whole train moves as a
             unit. -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web + JPA + the Postgres driver: exactly what the code USES.
             Four starters this pom used to declare have been REMOVED, and the reason for each is
             the same shape — a dependency nobody imports is not a harmless extra, it is a
             behaviour nobody asked for:

               security  — spring-boot-starter-security with NO SecurityFilterChain locks EVERY
                           endpoint behind a generated basic-auth password. A service whose
                           controllers are meant to be reachable would answer 401 to everything,
                           and the log line that explains it is one nobody reads.
               cache     — no @Cacheable anywhere in the source; the starter only adds a
                           caffeine dependency and a cache auto-configuration.
               redis     — no RedisTemplate anywhere in the source.
               validation— no @Valid / @NotNull / @Validated on any parameter.
               flyway    — there is NO db/migration directory, and the schema of these tables is
                           owned by drizzle in `apps/web/src/server/db/schema.ts`. A second
                           migration tool pointed at the same database would write its own
                           history table into a database it does not own. The honest arrangement is
                           ONE schema owner, and it is not this service. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Discovery, OPT-IN at runtime (see application.yml). This service is the one `nexus-api`
             reaches BY NAME through OpenFeign, so it has to be findable: without a registry the name
             resolves to nothing and the caller gets an honest 503. The client is on the classpath either
             way — `eureka.client.enabled` decides whether it actually dials anything, so a deployment
             without a registry still starts and still serves. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- The operator's door. MEASURED 2026-11-11: this module exposed
             `health,info,metrics,prometheus` in its application.yml and carried the Prometheus
             registry, but had NO actuator on the classpath at all — so `/actuator/prometheus`
             answered 404 and the whole management block was decoration. A configuration that names
             endpoints nothing can serve is the same class of lie as an answer that names a failure
             it did not have; the topology proof's §10b found it by asking the door. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    <!-- v656 — the bridge (only the bridge): this deployable RECEIVES the trace from the hop before it
         and continues it; it starts no outbound typed call of its own, so the Feign capability would be a
         dependency with nothing to attach to. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-brave</artifactId>
    </dependency>

    <!-- Prometheus scrape endpoint on the operator door: the door answers with the metrics
         the same services already produce, in the standard format nothing invents. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
  </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                    <source>25</source>
                    <target>25</target>
                    <compilerArgs>
                        <arg>-J-Dfile.encoding=UTF-8</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
