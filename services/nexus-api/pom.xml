<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEXUS — services/nexus-api (ADR 0011: the system of record; Java 25 + Spring Boot; owns PostgreSQL).

  M7 v193 is this service's FIRST slice: publish a project and read it back. The pom deliberately carries
  only what that slice needs — web, JPA, the Postgres driver — because every starter added here is a
  dependency the service owes an answer for later. Redis, security, and the AI-services boundary are NOT
  wired (ADR 0011 keeps them in `ai-svc`, and auth is a later M7 slice).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>dev.nexus</groupId>
  <artifactId>nexus-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>nexus-api</name>
  <description>NEXUS system of record (ADR 0011). First slice: publish a project and read it back.</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring Cloud 2025.0.3 is the release train that matches Spring Boot 3.5.x (this service's
         parent). The BOM is imported rather than the versions being spelled out one by one, so the
         whole train moves as a unit. -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Discovery, OPT-IN at runtime (see application.yml). The client is on the classpath so the
         service CAN register; `eureka.client.enabled` decides whether it actually does. A service
         whose optional dependency is absent must still start, so nothing here may be required for
         the service to answer. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>

    <!-- The TYPED client for the domain service: an interface is the contract, and the address comes
         from discovery rather than from a URL somebody typed into a config file. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <!-- The breaker that stands in front of that call. Without it a downstream that is down produces
         a timeout per request; with it, the failure is fast AND named. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
    </dependency>

    <!-- The operator's door: health, and the METRICS that say what the breakers are doing.
         Without the metrics there is no way to tell WHICH component refused a call — the 503
         says a service was unreachable, and the breaker's own state (OPEN, HALF_OPEN, CLOSED) is
         what turns that into an answer. It is NOT routed through the edge: the gateway's table
         matches only /api/**, so /actuator/** answers on this service's own port and nowhere else. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <release>25</release>
          <encoding>UTF-8</encoding>
          <source>25</source>
          <target>25</target>
          <compilerArgs>
            <arg>-J-Dfile.encoding=UTF-8</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
