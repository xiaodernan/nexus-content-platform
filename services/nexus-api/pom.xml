<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEXUS — services/nexus-api (ADR 0011: the system of record; Java 25 + Spring Boot; owns PostgreSQL).

  M7 v193 is this service's FIRST slice: publish a project and read it back. The pom deliberately carries
  only what that slice needs — web, JPA, the Postgres driver — because every starter added here is a
  dependency the service owes an answer for later. Redis, security, and the AI-services boundary are NOT
  wired (ADR 0011 keeps them in `ai-svc`, and auth is a later M7 slice).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>dev.nexus</groupId>
  <artifactId>nexus-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>nexus-api</name>
  <description>NEXUS system of record (ADR 0011). First slice: publish a project and read it back.</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
