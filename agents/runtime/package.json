{
  "name": "@nexus/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS M2 agent runtime core: deterministic demo planner + permission-scoped tool registry + hermetic workspace (§23/§25/§27, ADR 0013/0016). No network, no fs, no pretending (§60).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@nexus/ai-providers": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
